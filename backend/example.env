PORT=3000
NODE_ENV='developement'
# Preferred: TMDB API Read Access Token (v4); the backend adds the Bearer prefix if omitted.
TMDB_READ_ACCESS_TOKEN='<your-tmdb-api-read-access-token>'
# Alternative: TMDB v3 API key. Keep this server-side; do not put it in frontend VITE_* variables.
# TMDB_API_KEY='<your-tmdb-v3-api-key>'
# Legacy fallback, supported for existing deployments:
# API_AUTHORIZATION='Bearer <your-api-read-access-token>'
JWT_SECRET='<your-jwt-secret>'


POSTGRES_USER='cinetra'
POSTGRES_PASSWORD='cinetra'
POSTGRES_DB='cinetra'
DATABASE_URL="postgres://cinetra:cinetra@localhost:5432/cinetra"

# Web Push (new-episode notifications). Generate a key pair with `npm run vapid:generate` (backend).
# Keep VAPID_PRIVATE_KEY only in the backend runtime environment; never in frontend VITE_* variables.
# VAPID_PUBLIC_KEY='<url-safe-base64-public-key>'
# VAPID_PRIVATE_KEY='<url-safe-base64-private-key>'
# VAPID_SUBJECT='mailto:you@example.com'
# Background notifier: off unless set to "enabled". Runs inside the backend process.
# NOTIFICATIONS_SCHEDULER='enabled'
# NOTIFICATIONS_INTERVAL_MINUTES=15
