PORT=3000
NODE_ENV='developement'
# Preferred: TMDB API Read Access Token (v4); the backend adds the Bearer prefix if omitted.
TMDB_READ_ACCESS_TOKEN='<your-tmdb-api-read-access-token>'
# Alternative: TMDB v3 API key. Keep this server-side; do not put it in frontend VITE_* variables.
# TMDB_API_KEY='<your-tmdb-v3-api-key>'
# Legacy fallback, supported for existing deployments:
# API_AUTHORIZATION='Bearer <your-api-read-access-token>'
JWT_SECRET='<your-jwt-secret>'


POSTGRES_USER='cinetra'
POSTGRES_PASSWORD='cinetra'
POSTGRES_DB='cinetra'
DATABASE_URL="postgres://cinetra:cinetra@localhost:5432/cinetra"
