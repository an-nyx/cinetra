// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Show      Show[]
  Movie     Movie[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
}

model Show {
  id              String   @id @default(uuid())
  name            String
  overview        String?
  posterURL       String?
  seasonsWatched  Int      @default(0)
  episodesWatched Int      @default(0)
  completed       Boolean  @default(false)
  favorite        Boolean  @default(false)
  tmdbId          Int?
  tvmazeId        Int?
  status          String?
  episodeWatches  EpisodeWatch[]
  completedMonitorFrom DateTime?
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@unique([userId, tvmazeId])
  @@index([userId])
}

model EpisodeWatch {
  id        String   @id @default(uuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  season    Int
  episode   Int
  watchedAt DateTime @default(now())
  checkpointBeforeSeason Int?
  checkpointBeforeEpisode Int?
  checkpointAfterSeason Int?
  checkpointAfterEpisode Int?

  @@unique([showId, season, episode])
  @@index([showId, watchedAt])
}

model Movie {
  id        String   @id @default(uuid())
  name      String
  overview  String?
  posterURL String?
  favorite  Boolean  @default(false)
  tmdbId    Int?
  status    String?
  rating    Int?
  notes     String?
  watches   MovieWatch[]
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, tmdbId])
}

model MovieWatch {
  id        String   @id @default(uuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())

  @@index([movieId, watchedAt])
}

/// One row per user. Defaults: TV episode alerts on (once a device is subscribed), movies and digest off.
model NotificationPreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEpisodes Boolean  @default(true)
  movies      Boolean  @default(false)
  dailyDigest Boolean  @default(false)
  /// Only "all_except_dropped" is supported: every saved show except those marked Dropped.
  showScope   String   @default("all_except_dropped")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A browser/device Web Push subscription. The endpoint is a capability URL and is never returned to clients.
model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the endpoint, used for lookups so the raw endpoint never appears in a query log or URL.
  endpointHash String   @unique
  endpoint     String
  p256dh       String
  auth         String
  /// Episodes that premiered before this instant are never announced to this device (no backlog on opt-in).
  notifyFrom   DateTime
  userAgent    String?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deliveries   NotificationDelivery[]

  @@index([userId])
}

/// Durable delivery ledger. The unique key makes each (device, TVMaze episode, event) deliverable at most once.
model NotificationDelivery {
  id              String    @id @default(uuid())
  userId          String
  subscriptionId  String
  subscription    PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tvmazeShowId    Int
  tvmazeEpisodeId Int
  eventType       String
  /// Library show the notification opens (not a foreign key: the ledger outlives a removed show).
  showId          String
  season          Int
  episode         Int
  premieredAt     DateTime
  /// pending -> sending -> sent | retry | failed | expired | uncertain
  status          String    @default("pending")
  attempts        Int       @default(0)
  claimToken      String?
  claimedAt       DateTime?
  nextAttemptAt   DateTime  @default(now())
  sentAt          DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, subscriptionId, tvmazeShowId, tvmazeEpisodeId, eventType])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
}
